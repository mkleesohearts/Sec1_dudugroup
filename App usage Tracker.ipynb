import time
import psutil
import pandas as pd
import matplotlib.pyplot as plt
from datetime import datetime, timedelta
import os
import platform
import json
import yaml
import xml.etree.ElementTree as ET


# Configuration
LOG_FILE = "app_usage.csv"
LOG_INTERVAL_MINUTES = 5
USAGE_ANALYSIS_HOURS = 24
USAGE_LIMIT_MINUTES = 60


IGNORE_PROCESSES = {
   "Windows": ["System Idle Process", "System", "svchost.exe", "RuntimeBroker.exe"],
   "Linux": ["kthreadd", "rcu_sched", "rcu_bh"],
   "Darwin": ["kernel_task", "launchd"]
}




def get_os_name():
   return platform.system()




def app_usage():
   current_os = get_os_name()
   ignored = IGNORE_PROCESSES.get(current_os, [])
   records = []
   timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")






   for proc in psutil.process_iter(['name']):
       try:
           name = proc.info['name']
           if name and name not in ignored:
               records.append({'Timestamp': timestamp, 'App Name': name})
       except (psutil.NoSuchProcess, psutil.AccessDenied, psutil.ZombieProcess):
           continue


   if records:
       df = pd.DataFrame(records)
       df.to_csv(LOG_FILE, mode='a', index=False, header=not os.path.exists(LOG_FILE))




def analyze_usage():
   if not os.path.exists(LOG_FILE):
       print("No log file found.")
       return


   df = pd.read_csv(LOG_FILE)
   df['Timestamp'] = pd.to_datetime(df['Timestamp'])
   now = datetime.now()
   time_limit = now - timedelta(hours=USAGE_ANALYSIS_HOURS)
   df_recent = df[df['Timestamp'] >= time_limit]


   if df_recent.empty:
       print(f"No usage data in the last {USAGE_ANALYSIS_HOURS} hours.")
       return


   usage_counts = df_recent['App Name'].value_counts()
   estimated_minutes = usage_counts * LOG_INTERVAL_MINUTES


   exceeded_apps = estimated_minutes[estimated_minutes > USAGE_LIMIT_MINUTES]




   if not exceeded_apps.empty:
       print(f"\nApplications exceeding the usage limit ({USAGE_LIMIT_MINUTES} minutes):")
       for app, minutes in exceeded_apps.items():
           print(f" - {app}: {minutes} minutes")
   else:
       print("\nNo applications exceeded the usage limit.")


   top_apps = estimated_minutes.head(10)
   colors = ['red' if minutes > USAGE_LIMIT_MINUTES else 'steelblue' for minutes in top_apps]


   plt.figure(figsize=(12, 6))
   top_apps.plot(kind='barh', color=colors)
   plt.xlabel("Estimated Usage Time (minutes)")
   plt.title("Top 10 Most Used Applications (Last 24 Hours)")
   plt.gca().invert_yaxis()
   plt.grid(axis='x', linestyle='--', alpha=0.7)
   plt.tight_layout()
   plt.show()




def export_usage_data():
   if not os.path.exists(LOG_FILE):
       print("No log file to export.")
       return


   df = pd.read_csv(LOG_FILE)
   df['Timestamp'] = pd.to_datetime(df['Timestamp'])
   now = datetime.now()
   time_limit = now - timedelta(hours=USAGE_ANALYSIS_HOURS)
   df_recent = df[df['Timestamp'] >= time_limit]


   if df_recent.empty:
       print("No recent data to export.")
       return
   usage_counts = df_recent['App Name'].value_counts()
   estimated_minutes = (usage_counts * LOG_INTERVAL_MINUTES).reset_index()
   estimated_minutes.columns = ['App Name', 'Estimated Minutes']


   # Export to TXT
   with open("app_usage.txt", "w", encoding="utf-8") as f:
       for _, row in estimated_minutes.iterrows():
           f.write(f"{row['App Name']}: {row['Estimated Minutes']} minutes\n")


   # Export to JSON
   estimated_minutes.to_json("app_usage.json", orient='records', indent=4)


   # Export to YAML
   with open("app_usage.yaml", "w", encoding="utf-8") as f:
       yaml.dump(estimated_minutes.to_dict(orient='records'), f, allow_unicode=True)


   # Export to Markdown
   with open("app_usage.md", "w", encoding="utf-8") as f:
       f.write("## App Usage Summary (Last 24 Hours)\n\n")
       for _, row in estimated_minutes.iterrows():
           f.write(f"- **{row['App Name']}**: {row['Estimated Minutes']} minutes\n")


   # Export to XML
   root = ET.Element("AppUsage")
   for _, row in estimated_minutes.iterrows():
       app_elem = ET.SubElement(root, "App")
       name_elem = ET.SubElement(app_elem, "Name")
       name_elem.text = row['App Name']
       time_elem = ET.SubElement(app_elem, "EstimatedMinutes")
       time_elem.text = str(row['Estimated Minutes'])


   tree = ET.ElementTree(root)
   tree.write("app_usage.xml", encoding="utf-8", xml_declaration=True)


   print("Export completed: TXT, JSON, YAML, Markdown, and XML files generated.")
if __name__ == "__main__":
   try:
       app_usage()
       analyze_usage()
       export_usage_data()
   except Exception as e:
       print(f"An error occurred: {e}")
